{
    "editor.formatOnSave": false,
    "[markdown]": {
        "editor.formatOnSave": false,
        "editor.defaultFormatter": null
    },
    "markdown.extension.tableFormatter.enabled": false,
    "markdown.extension.toc.autofill": false,

    // Hide Windows folder system files that can appear in repo folders
    // See ../DESKTOP_INI_IGNORE.md for context and how to undo this if needed
    "files.exclude": {
        "**/desktop.ini": true
    }
}